# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=clients

# Shared subscription access token: generate 32 random bytes as 64 lowercase hex.
# Store only its SHA-256 hash here; keep the bearer token in the client/private channel.
# All nodes use one authenticated HTTPS /sub/<token> subscription URL.
SUBSCRIPTION_TOKEN_SHA256=CHANGE_ME_TO_64_HEX_SHA256_HASH

# VLESS TCP TLS node
SUBSCRIPTION_NODE_UUID=CHANGE_ME_UUID
SUBSCRIPTION_NODE_HOST=yourdomain.com
SUBSCRIPTION_NODE_PORT=8443
SUBSCRIPTION_NODE_SNI=yourdomain.com
SUBSCRIPTION_NODE_NAME=🇺🇸 美国-client1

# Optional Hysteria2 node; host and SNI default to the VLESS node
HYSTERIA2_ENABLED=false
HYSTERIA2_NAME=🇺🇸 美国-HY2
HYSTERIA2_PORT=8443
HYSTERIA2_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
HYSTERIA2_OBFS_PASSWORD=CHANGE_ME_LONG_RANDOM_OBFS_PASSWORD
# Leave both at 0 to use adaptive BBR; set both positive only for measured link rates.
# Keep UP at 0: a fixed upload rate (client-side Brutal) wedges idle connections.
HYSTERIA2_UP_MBPS=0
HYSTERIA2_DOWN_MBPS=0

# Optional VLESS WebSocket TLS node
MOBILE_WS_ENABLED=false
MOBILE_WS_NAME=🇺🇸 美国-443
MOBILE_WS_PORT=443
MOBILE_WS_LOCAL_PORT=10086
MOBILE_WS_PATH=/api/vless-ws
MOBILE_WS_HOST=yourdomain.com
MOBILE_WS_SNI=yourdomain.com
